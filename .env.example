# Copiez ce fichier en « .env » puis adaptez les valeurs. Le fichier .env n'est jamais envoyé sur GitHub.

# --- Production (obligatoire en ligne) ---
DJANGO_DEBUG=0
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacez-par-une-longue-cle-aleatoire
DJANGO_ALLOWED_HOSTS=votrecompte.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://votrecompte.pythonanywhere.com
SITE_URL=https://votrecompte.pythonanywhere.com

# --- Emails (facultatif) : exemple avec Gmail et un « mot de passe d'application » ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=votre.adresse@gmail.com
# EMAIL_HOST_PASSWORD=motdepassedapplication
# DEFAULT_FROM_EMAIL=FLEET MANAGER <votre.adresse@gmail.com>

# --- PostgreSQL (facultatif ; SQLite par défaut) ---
# DB_ENGINE=postgresql
# DB_NAME=fleet_manager
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
